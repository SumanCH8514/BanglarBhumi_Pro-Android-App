# ====================================================================
# Android Studio / Android / Gradle Ignored Files
# ====================================================================

# Built application files and binaries
*.apk
*.aar
*.ap_
*.aab
*.dex

# Files for the ART/Dalvik VM
*.class

# Gradle & Build caches
.gradle/
build/
*/build/
app/build/
.kotlin/
kotlin-daemon/
Bengal_Land_Record_Inspection_Report.md

# Local configuration file (sdk.dir, local paths, credentials)
# CRITICAL: Contains machine paths and potential signing keys
local.properties
local.properties.*

# ProGuard folder generated by Eclipse
proguard/

# Log files
*.log
logcat*.txt
dumpsys*.txt

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures (traces, heap dumps)
captures/

# Keystores & Signing credentials
# CRITICAL: Prevent private signing keys and certificates from leaking
*.jks
*.keystore
*.key
*.pem
*.p12
*.pfx
*.pkcs12
*.bks
keystore.properties
signing.properties
release-keystore.properties

# Google Services / Firebase credentials
# Note: Keep commented unless using proprietary google-services.json
# google-services.json
# GoogleService-Info.plist

# ====================================================================
# Session, Cookie, and Network Dumps
# ====================================================================
cookies.txt
*.cookie
*.cookies
*.session
*.pcap
*.har

# ====================================================================
# Web / Node.js Workspace (web/)
# ====================================================================
node_modules/
*/node_modules/
web/node_modules/
dist/
*/dist/
web/dist/
.vite/
*/.vite/
web/.vite/
web/.vite-temp/
*.tsbuildinfo

# Node environment variables and secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# NPM/Yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ====================================================================
# OS & System-Specific Files
# ====================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Backup and temp files
*~
*.bak
*.swp
*.swo
*.tmp
